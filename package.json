{
  "name": "bos-skillset",
  "version": "1.0.1",
  "description": "BOS as skills and plugins for AI agents: Claude Code plugin, Agent Skills, Gemini CLI extension and an MCP server over the Blacksmith Organization System core",
  "keywords": [
    "bos",
    "blacksmith-organization-system",
    "agent-skills",
    "claude-code-plugin",
    "gemini-cli-extension",
    "mcp",
    "workshop",
    "ai-agents"
  ],
  "homepage": "https://github.com/Sarverott/bos-skillset#readme",
  "bugs": {
    "url": "https://github.com/Sarverott/bos-skillset/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sarverott/bos-skillset.git"
  },
  "license": "MIT",
  "author": "Sett Sarverott A.A.B.",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {
    "bos-skillset": "bin/bos"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    ".claude-plugin",
    "AGENTS.md",
    "BOS-CONTEXT.md",
    "CLAUDE.md",
    "GEMINI.md",
    "LICENSE",
    "README.md",
    "bin",
    "commands",
    "dist",
    "docs/glossary",
    "gemini-extension.json",
    "hooks",
    "resources",
    "skills",
    "src",
    "template"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node bin/bos workshop status",
    "build": "node esbuild.config.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "bos": "node bin/bos",
    "prepare": "husky",
    "commit": "cz",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "blacksmith-organization-system": "^1.5.1",

    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@go-task/cli": "^3.45.4",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "skills": "^1.7.0",
    "vitest": "^5.0.2"
  }
}
