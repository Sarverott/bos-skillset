{
  "id": 26685894,
  "name": "Copilot review for default branch",
  "target": "branch",
  "source_type": "Repository",
  "source": "Sarverott/bos-skillset",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "copilot_code_review",
      "parameters": {
        "review_on_push": false,
        "review_draft_pull_requests": true
      }
    }
  ],
  "bypass_actors": []
}